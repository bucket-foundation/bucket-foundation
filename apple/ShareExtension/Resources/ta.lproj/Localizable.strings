"Open %@, sign in from Account, then share again to send this to your family and friends." = "%@ ஐத் திறந்து, கணக்கிலிருந்து உள்நுழைந்து, இதைக் குடும்பத்துக்கும் நண்பர்களுக்கும் அனுப்ப மீண்டும் பகிருங்கள்.";
"Send" = "அனுப்பு";
