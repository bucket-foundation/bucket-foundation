/* Privacy - Microphone Usage Description */
"NSMicrophoneUsageDescription" = "Bucket hört zu, wenn du auf Sprechen oder das Mikrofon tippst, damit du ein Wort üben oder ein Wort oder einen Satz zum Übersetzen sagen kannst. Außerdem nimmt es die Sprachnachrichten auf, die du an deine Gruppe sendest.";

/* Privacy - Speech Recognition Usage Description */
"NSSpeechRecognitionUsageDescription" = "Bucket wandelt Gesprochenes in Text um, um deine Aussprache zu prüfen oder das gesagte Wort oder den Satz zu übersetzen. Die meisten Sprachen bleiben auf deinem Gerät; manche werden zur Erkennung an Apple gesendet. Außerdem wandelt es die Sprachnachrichten, die du an deine Gruppe sendest, in Text um.";

/* Privacy - Photo Library Additions Usage Description */
"NSPhotoLibraryAddUsageDescription" = "Bucket speichert eine Teilen-Karte in deinen Fotos, wenn du Bild sichern wählst.";

