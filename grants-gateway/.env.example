# grants-gateway — environment variables
#
# Copy to .env (gitignored) and fill in. All values shown are defaults;
# none are required to boot the dev server (it runs against the in-memory
# fixture).

# Network port
PORT=8789

# x402 merchant config (Base or Base Sepolia)
FEED402_CHAIN=base-sepolia
FEED402_WALLET=0x0000000000000000000000000000000000000000

# Optional: x402 facilitator endpoint for real payment verification.
# When unset the server runs in STUB mode (any x-payment header counts).
# FEED402_FACILITATOR_URL=https://facilitator.x402.rs
# FEED402_VERIFY_MODE=facilitator

# Viatika vendor metering (bkt-???, P3 — see README "Next beads").
# When unset, metering is a no-op. When set, every paid call also pings
# the Viatika credit ledger BEFORE serving.
# VIATIKA_API_URL=https://api.viatika.ai
# VIATIKA_API_KEY=
# VIATIKA_TENANT_ID=bucket-foundation
# VIATIKA_PRODUCT=grants-gateway

# Insight LLM (bkt-???, P2 — see README "Next beads").
# When unset, /grants/insight returns a deterministic mock synthesis.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# INSIGHT_MODEL=claude-3-5-sonnet-20241022

# Provider identity (emitted in citation envelopes)
PROVIDER_NAME=bucket-grants-gateway
PROVIDER_DOMAIN=grants.bucket.foundation
