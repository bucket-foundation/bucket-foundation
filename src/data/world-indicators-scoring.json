    "Unemployment (% of labor force)": "lower",
    "Gini index (inequality)": "lower",
    "Household consumption per capita (const US$)": "higher",
    "Population, total": "neutral",
    "Urban population (%)": "neutral",
    "Population growth (% annual)": "neutral",
    "Population density (per sq km)": "neutral",
    "Fertility rate (births per woman)": "neutral",
    "Education expenditure (% of GDP)": "higher",
    "Adult literacy rate (%)": "higher",
    "Tertiary school enrollment (% gross)": "higher",
    "CO2 emissions per capita (t)": "lower",
    "Forest area (% of land)": "higher",
