    "human": "PREFIX wd: <http://www.wikidata.org/entity/>\nPREFIX wdt: <http://www.wikidata.org/prop/direct/>\nSELECT ?year ?country (COUNT(?p) AS ?n) WHERE {\n  {\n    SELECT ?p (MIN(YEAR(?b)) AS ?year) (MIN(?c) AS ?country) WHERE {\n      ?p wdt:P31 wd:Q5 ; wdt:P569 ?b ; wdt:P19 ?bp .\n      ?bp wdt:P17 ?c .\n      FILTER(STRENDS(STR(?p), \"<digit>\"))\n    } GROUP BY ?p\n  }\n} GROUP BY ?year ?country\n",
    "site": "PREFIX wd: <http://www.wikidata.org/entity/>\nPREFIX wdt: <http://www.wikidata.org/prop/direct/>\nSELECT ?item (MIN(YEAR(?d)) AS ?year) (MIN(STR(?coord)) AS ?point) WHERE {\n  ?item wdt:P31/wdt:P279* wd:Q839954 ; wdt:P625 ?coord .\n  { ?item wdt:P571 ?d } UNION { ?item wdt:P580 ?d } UNION { ?item wdt:P1319 ?d }\n} GROUP BY ?item\n",
