{
  "POST unconfigured": {
    "status": 503,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "research_os_unavailable"
    }
  },
  "POST anonymous": {
    "status": 401,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "unauthorized"
    }
  },
  "POST signed in, store down": {
    "status": 400,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "action must be one of locate, quote, check, organize"
    }
  },
  "POST signed in, malformed json": {
    "status": 400,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "bad_request"
    }
  },
  "POST signed in, consent unavailable": {
    "status": 503,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "consent_unavailable",
      "message": "Consent could not be checked right now. Try again in a moment."
    }
  },
  "POST signed in, consent refused": {
    "status": 403,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "no_profile",
      "message": "",
      "needsProfile": true
    }
  },
  "POST signed in, null body": {
    "status": 400,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "action must be one of locate, quote, check, organize"
    }
  },
  "POST locate, no query": {
    "status": 400,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "query is required"
    }
  },
  "POST locate, second source without node": {
    "status": 400,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "quotedSourceNodeId is required for secondSource mode"
    }
  },
  "POST quote, no node": {
    "status": 400,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "nodeId is required"
    }
  },
  "POST quote, store down": {
    "status": 503,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "access_unavailable"
    }
  },
  "POST organize, empty": {
    "status": 400,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "at least one field is required"
    }
  },
  "POST quote, authorize throws": {
    "status": 503,
    "cache": "no-store",
    "type": "application/json",
    "body": {
      "error": "research_os_unavailable"
    }
  }
}
