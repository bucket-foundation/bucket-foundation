# tools/hypothesis-engine/Makefile
#
# `test` is the every-commit gate: the `fast` hypothesis profile (40
# examples per property, tests/conftest.py) with everything measured to
# exceed 2s under that profile skipped, stopping at the first failure.
# `test-full` is the whole suite at the `full` profile (300 examples),
# nothing skipped, for a pre-release or nightly run. `test-durations`
# re-measures per-test call time under the fast profile, the input to
# refreshing tests/conftest.py's `_SLOW_NODEIDS` by hand after the suite
# changes shape. `test-cov` needs the `coverage` package (already present
# in this environment as of 2026-09-10); see its recipe for what to
# install otherwise.

.ONESHELL:

PYTHON := python3
PYTEST := $(PYTHON) -m pytest

# pytest-xdist gives `-n auto` (one worker per CPU core). Not installed in
# this environment as of 2026-09-10; install without sudo with
# `pip install --user pytest-xdist`. `test`/`test-full` fall back to a
# serial run when it is absent rather than failing.
XDIST := $(shell $(PYTHON) -c "import xdist" >/dev/null 2>&1 && echo 1)
ifeq ($(XDIST),1)
PARALLEL := -n auto
else
PARALLEL :=
endif

COVERAGE_HTML := .coverage-html
COVERAGE_JSON := .coverage.json

.PHONY: test test-full test-durations test-cov

test:
	HTE_TEST_PROFILE=fast $(PYTEST) -m "not slow" -x -q -p no:cacheprovider $(PARALLEL)

test-full:
	HTE_TEST_PROFILE=full $(PYTEST) -q -p no:cacheprovider $(PARALLEL)

test-durations:
	HTE_TEST_PROFILE=fast $(PYTEST) -q -p no:cacheprovider --durations=0

# Branch coverage over hte/ at the full profile: a coverage read is an
# occasional, standalone command, so it earns the extra depth and the
# extra time. Writes the standard HTML report under .coverage-html/
# (gitignored) and tests/COVERAGE.md: the 15 files with the lowest
# coverage percentage, each with its uncovered line ranges, as the
# target list for the next test swarm. Runs serially: combining
# coverage.py's data file across pytest-xdist workers needs
# `--cov-context`/`coverage combine` wiring this target skips, a fair
# trade for a command run this rarely.
#
# The report generator below is flat Python by construction (lambdas and
# comprehensions, no `def`/`for`/`if` block statements): every physical
# line of a Makefile recipe carries its own leading-tab requirement, and
# GNU Make strips each line down past that tab before the shell ever
# sees it, which erases any indentation a nested block would depend on.
# Comprehensions and parenthesized expressions are immune, since Python
# does not use indentation to parse inside an open `(`/`[`/`{`.
test-cov:
	@if ! $(PYTHON) -c "import coverage" >/dev/null 2>&1; then \
		echo "coverage is not installed."; \
		echo "Install it without sudo: pip install --user coverage"; \
		echo "(pip install --user pytest-cov also works: it pulls coverage in as a dependency)"; \
		exit 1; \
	fi
	HTE_TEST_PROFILE=full $(PYTHON) -m coverage run --branch --source=hte -m pytest -q -p no:cacheprovider tests
	$(PYTHON) -m coverage html -d $(COVERAGE_HTML)
	$(PYTHON) -m coverage json -o $(COVERAGE_JSON) -q
	$(PYTHON) -m coverage report -m
	$(PYTHON) - <<-'PYEOF'
	import itertools
	import json
	from pathlib import Path

	data = json.loads(Path(".coverage.json").read_text())
	files = data["files"]
	totals = data["totals"]
	cwd = Path.cwd()

	line_ranges = lambda nums: (
	    ", ".join(
	        str(grp[0][1]) if grp[0][1] == grp[-1][1] else f"{grp[0][1]}-{grp[-1][1]}"
	        for grp in (
	            list(g) for _, g in itertools.groupby(enumerate(sorted(nums)), key=lambda t: t[1] - t[0])
	        )
	    ) if nums else "(none)"
	)

	disp = lambda path: (
	    str(Path(path).relative_to(cwd))
	    if Path(path).is_absolute() and Path(path).is_relative_to(cwd)
	    else path
	)

	rows = sorted(
	    (
	        (
	            files[p]["summary"]["percent_covered"],
	            disp(p),
	            files[p]["summary"]["covered_lines"],
	            files[p]["summary"]["num_statements"],
	            files[p].get("missing_lines", []),
	        )
	        for p in files
	    ),
	    key=lambda r: r[0],
	)
	worst = rows[:15]

	branch_note = (
	    f", {totals['covered_branches']}/{totals['num_branches']} branches"
	    if totals.get("num_branches") else ""
	)

	header = (
	    "# Coverage report\n\n"
	    "Generated by `make test-cov`: branch coverage over `hte/` at the full "
	    "hypothesis profile (300 examples per property).\n\n"
	    f"Total: {totals['percent_covered']:.1f}% "
	    f"({totals['covered_lines']}/{totals['num_statements']} statements{branch_note}).\n\n"
	    "## 15 least-covered files\n\n"
	    "Lowest coverage percentage first. Uncovered line ranges are the "
	    "target list for the next test swarm.\n\n"
	    "| File | Coverage | Statements | Uncovered lines |\n"
	    "|---|---:|---:|---|\n"
	)

	body = "".join(
	    f"| `{path}` | {pct:.1f}% | {covered}/{stmts} | {line_ranges(missing)} |\n"
	    for pct, path, covered, stmts, missing in worst
	)

	Path("tests/COVERAGE.md").write_text(header + body)
	print(f"wrote tests/COVERAGE.md ({len(worst)} files listed, total {totals['percent_covered']:.1f}%)")
	PYEOF
