 "id": "twinprime",
 "title": "Twin prime conjecture",
 "statement": {
  "text": "A twin prime is a prime number that is either 2 less or 2 more than another prime number—for example, either member of the twin prime pair    or (41, 43). In other words, a twin prime is a prime that has a prime gap of two. Sometimes the term twin prime is used for a pair of twin primes; an alternative name for this is prime twin or prime pair or twin prime pair.",
  "source": "https://en.wikipedia.org/wiki/Twin_prime",
  "licence": "CC BY-SA 4.0",
  "attribution": {
   "title": "Twin prime",
   "url": "https://en.wikipedia.org/wiki/Twin_prime"
  }
 },
