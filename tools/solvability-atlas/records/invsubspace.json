 "id": "invsubspace",
 "title": "Invariant subspace problem",
 "statement": {
  "text": "In the field of mathematics known as functional analysis, the invariant subspace problem is a partially unresolved problem asking whether every bounded operator on a complex Banach space sends some non-trivial closed subspace to itself. Many variants of the problem have been solved, by restricting the class of bounded operators considered or by specifying a particular class of Banach spaces. The problem is still open for separable Hilbert spaces.",
  "source": "https://en.wikipedia.org/wiki/Invariant_subspace_problem",
  "licence": "CC BY-SA 4.0",
  "attribution": {
   "title": "Invariant subspace problem",
   "url": "https://en.wikipedia.org/wiki/Invariant_subspace_problem"
  }
 },
