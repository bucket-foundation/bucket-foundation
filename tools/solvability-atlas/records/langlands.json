 "id": "langlands",
 "title": "Langlands program",
 "statement": {
  "text": "In mathematics, the Langlands program is a set of conjectures about connections between number theory, the theory of automorphic forms, and geometry. It was proposed by the Canadian mathematician Robert Langlands. More precisely, it seeks to relate the structure of Galois groups in algebraic number theory to automorphic forms and, more generally, the representation theory of algebraic groups over local fields and adeles.",
  "source": "https://en.wikipedia.org/wiki/Langlands_program"
 },
