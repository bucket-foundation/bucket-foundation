{
 "schema": "bucket.solvability-atlas.record/v1",
 "id": "zkp",
 "title": "Succinct proofs without trusted setup optimality",
 "statement": {
  "text": "In cryptography, a zero-knowledge proof is a protocol in which one party can convince another party that some given statement is true, without conveying to the verifier any information beyond the mere fact of that statement's truth. The intuition behind the nontriviality of zero-knowledge proofs is that it is trivial to prove possession of the relevant information simply by revealing it; the hard part is to prove this possession without revealing this information.",
  "source": "https://en.wikipedia.org/wiki/Zero-knowledge_proof",
  "licence": "CC BY-SA 4.0",
  "attribution": {
   "title": "Zero-knowledge proof",
   "url": "https://en.wikipedia.org/wiki/Zero-knowledge_proof"
  }
 },
