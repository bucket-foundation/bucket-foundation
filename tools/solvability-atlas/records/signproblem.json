 "id": "signproblem",
 "title": "Fermion sign problem",
 "statement": {
  "text": "In applied mathematics, the numerical sign problem is the problem of numerically evaluating the integral of a highly oscillatory function of a large number of variables. Numerical methods fail because of the near-cancellation of the positive and negative contributions to the integral. Each has to be integrated to very high precision in order for their difference to be obtained with useful accuracy.",
  "source": "https://en.wikipedia.org/wiki/Numerical_sign_problem",
  "licence": "CC BY-SA 4.0",
  "attribution": {
   "title": "Numerical sign problem",
   "url": "https://en.wikipedia.org/wiki/Numerical_sign_problem"
  }
 },
