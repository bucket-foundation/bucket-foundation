[Unit]
Description=Bucket TestFlight feedback pull
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/agfarms/bucket-foundation
Environment=BUCKET_REPO=%h/agfarms/bucket-foundation
Environment=PATH=%h/bin:%h/go/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'set -a; . %h/.derbyfish-secrets/asc-api-key.env; set +a; exec node tools/testflight-feedback/run.mjs'
Nice=10
