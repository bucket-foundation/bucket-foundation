[Unit]
Description=Bucket TestFlight daily digest to Telegram

[Service]
Type=oneshot
WorkingDirectory=%h/agfarms/bucket-foundation
Environment=TOOL_ROOT=%h/agfarms/bucket-foundation
Environment=PATH=%h/bin:%h/go/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=2min
ExecStart=/usr/bin/flock -n %t/bucket-testflight-digest.lock /bin/bash -c 'exec node "$TOOL_ROOT/tools/testflight-feedback/run.mjs" --digest'
Nice=10
