ankka"},{"lemma":"sanoa","surface":"sanoi"}],"translation":"\"One egg is not hatched yet,\" said the duck."},{"cefr":"A2","id":"tatoeba:fi:6115177","kind":"sentence","lang":"fi","lemmas":["joka","kaunis","kerta","kolme","kuningas","olla","tytär"],"license":"CC-BY 2.0 FR","source":{"authors":{"en":"Hybrid","fi":"Orava"},"name":"tatoeba","sentenceIds":{"en":"4540422","fi":"6115177"},"url":"https://tatoeba.org/en/sentences/show/6115177"},"text":"Olipa kerran kuningas, jolla oli kolme kaunista tytärtä.","tokens":[{"lemma":"olla","surface":"Olipa"},{"lemma":"kerta","surface":"kerran"},{"lemma":"kuningas","surface":"kuningas"},{"lemma":"joka","surface":"jolla"},{"lemma":"olla","surface":"oli"},{"lemma":"kolme","surface":"kolme"},{"lemma":"kaunis","surface":"kaunista"},{"lemma":"tytär","surface":"tytärtä"}],"translation":"Once upon a time, there was a king who had three beautiful daughters."},{"cefr":"B1","id":"tatoeba:fi:5293599","kind":"sentence","lang":"fi","lemmas":["joka","kansa","moni","olla","syntyä"],"license":"CC-BY 2.0 FR","source":{"authors":{"en":"Hybrid","fi":"Orava"},"name":"tatoeba","sentenceIds":{"en":"5287320","fi":"5293599"},"url":"https://tatoeba.org/en/sentences/show/5293599"},"text":"Olemme kansa, joka on syntynyt monista kansoista.","tokens":[{"lemma":"olla","surface":"Olemme"},{"lemma":"kansa","surface":"kansa"},{"lemma":"joka","surface":"joka"},{"lemma":"olla","surface":"on"},{"lemma":"syntyä","surface":"syntynyt"},{"lemma":"moni","surface":"monista"},{"lemma":"kansa","surface":"kansoista"}],"translation":"We are a people born of many peoples."},{"cefr":"B1","id":"tatoeba:fi:8286133","kind":"sentence","lang":"fi","lemmas":["aurinko","aurinkokunta","olla","tähti","vain","yksi"],"license":"CC-BY 2.0 FR","source":{"authors":{"en":"Hybrid","fi":"Orava"},"name":"tatoeba","sentenceIds":{"en":"6294058","fi":"8286133"},"url":"https://tatoeba.org/en/sentences/show/8286133"},"text":"Aurinkokunnassa on vain yksi tähti, aurinko.","tokens":[{"lemma":"aurinkokunt