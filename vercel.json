{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "run/*": false,
      "intake/*": false,
      "data/*": false,
      "*/hte-*": false,
      "hte/*": false,
      "ops/*": false,
      "gate/*": false,
      "measure/*": false,
      "feat/*": false,
      "fix/*": false,
      "refactor/*": false,
      "chore/*": false,
      "test/*": false,
      "docs/*": false,
      "build/*": false,
      "ci/*": false,
      "perf/*": false,
      "style/*": false,
      "review/*": false,
      "release/*": false,
      "hotfix/*": false,
      "claude/*": false,
      "agent/*": false
    }
  },
