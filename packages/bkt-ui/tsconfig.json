{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "paths": { "@academy/*": ["../../src/lib/academy/*"], "@ros/*": ["../../src/lib/research-os/*"] }
  },
  "include": ["src", "scripts", "vite.config.ts"]
}
