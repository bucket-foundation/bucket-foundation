# papers/history-hypothesis-engine/Makefile: copied from papers/template/,
# see PAPER-STANDARDS.md for the rules this file follows.
#
# latexmk is not installed in this environment (PAPER-STANDARDS.md,
# "Toolchain notes"), so `pdf` runs the pdflatex/biber/pdflatex/pdflatex
# sequence by hand: one pass to write the .bcf, biber to resolve citations
# from it, then two more passes so cross-references (\Cref) and the
# bibliography both settle.
#
# The full from-scratch chain for this paper is figures -> lean ->
# snapshots -> pdf; a contributor rebuilding everything runs
# `make figures pdf`. The two steps are not chained automatically into one
# `pdf` prerequisite for different reasons:
#
#   - `figures`: every fig_*.pdf under figures/ is already built and
#     committed (seven figures, generated by their own fig_*.py scripts and
#     reviewed against figures/CAPTIONS.md). Each script is a pure function
#     of its inputs, but matplotlib's PDF backend still stamps a fresh
#     /CreationDate into every regenerated file (confirmed this pass: two
#     back-to-back `make figures` runs produced byte-identical images at a
#     different file offset, the embedded timestamp), so wiring `figures`
#     into `pdf`'s prerequisites would dirty seven committed binaries on
#     every single build for no visual change. `make figures` stays
#     available to rebuild them by hand when a fig_*.py script itself
#     changes.
#   - `lean` -> `lean-snapshot`: `lean-snapshot` depends on `lean`, so Lean
#     source that fails to type-check never reaches the snapshot step.
#     `lean-snapshot` copies lean/Bucket/*.lean into lean-snapshots/ as
#     ASCII-safe transliterations: Lean 4 source is Unicode throughout,
#     which plain pdflatex plus listings (no listingsutf8, no Unicode math
#     font on this machine) cannot \lstinputlisting directly. main.tex's
#     \bucketlean macro always has a byte-safe target to test with
#     \IfFileExists, real listing or pending note, on every run.
#
# `pdf` depends on `lean-snapshot` (hence transitively on `lean`), then
# runs the pdflatex/biber/pdflatex/pdflatex sequence by hand, since
# latexmk is not installed (PAPER-STANDARDS.md, "Toolchain notes"): one
# pass to write the .bcf, biber to resolve citations from it, then two
# more passes so cross-references (\Cref) and the bibliography both
# settle.

PAPER   := main
PYTHON  := python3

.PHONY: pdf figures lean lean-snapshot lint clean

pdf: lean-snapshot
	pdflatex -interaction=nonstopmode -halt-on-error $(PAPER).tex
	biber $(PAPER)
	pdflatex -interaction=nonstopmode -halt-on-error $(PAPER).tex
	pdflatex -interaction=nonstopmode -halt-on-error $(PAPER).tex

figures:
	$(PYTHON) figures/build_all.py

lean:
	cd lean && lake build

lean-snapshot: lean
	$(PYTHON) make_lean_snapshots.py

lint:
	@# agf-lint-voice only recognizes .md/.mdx/.txt/.rst (see agf-lint-voice's
	@# TEXT_EXTS), and its .voiceallow lookup walks upward from the linted
	@# file's own directory to $$HOME, so the copy has to land inside this
	@# repo (papers/history-hypothesis-engine/), not /tmp, or it never sees
	@# bucket-foundation's .voiceallow and legitimate field terms misreport
	@# as violations.
	@tmp=.lint-tmp.md; \
	cp $(PAPER).tex "$$tmp"; \
	status=0; \
	agf-lint-voice check "$$tmp" || status=$$?; \
	rm -f "$$tmp"; \
	exit $$status

clean:
	rm -f $(PAPER).aux $(PAPER).bbl $(PAPER).bcf $(PAPER).blg $(PAPER).log \
	      $(PAPER).out $(PAPER).run.xml $(PAPER).synctex.gz $(PAPER).toc \
	      $(PAPER).pdf
	rm -rf lean/.lake lean-snapshots
