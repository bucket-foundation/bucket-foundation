      "end": -30,
      "title": "OSM location of Archaeological site of G\u00fcltepe H\u00f6y\u00fc\u011f\u00fc",
      "provenance": "OpenStreetMap (Way 170004641, version 1, osm:changeset=12102929, 2012-07-03T18:20:45Z)",
