      "end": -30,
      "title": "Imagery location of so-called Underground Shrine",
      "provenance": "Pleiades",
      "associationCertaintyURI": "https://pleiades.stoa.org/vocabularies/association-certainty/certain",
      "start": -550,
      "locationTypeURI": [
