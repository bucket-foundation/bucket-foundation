      "id": "center-point-of-archaeological-site-of-barzan",
      "featureTypeURI": [
        "https://pleiades.stoa.org/vocabularies/place-types/settlement"
      ],
      "end": 300,
      "title": "Center point of archaeological site of Barzan",
      "provenance": "Pleiades",
      "associationCertaintyURI": "https://pleiades.stoa.org/vocabularies/association-certainty/certain",
      "start": -30,
      "locationTypeURI": [
