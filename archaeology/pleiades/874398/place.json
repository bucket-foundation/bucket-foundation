  "title": "Bavian/Khinnis",
  "provenance": "Barrington Atlas: BAtlas 89 F4 Bavian",
  "placeTypeURIs": [
    "https://pleiades.stoa.org/vocabularies/place-types/canal",
    "https://pleiades.stoa.org/vocabularies/place-types/architecturalcomplex",
