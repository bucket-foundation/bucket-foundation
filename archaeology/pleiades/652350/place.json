    {
      "end": -540,
      "description": "Kundu and Siss\u00fb are mentioned together in royal inscriptions of the Neo-Assyrian king Esarhaddon (r. 680-669 BC) and, thus, presumably located near one another.",
      "contributors": [],
      "created": "2020-08-22T15:17:26Z",
      "associationCertainty": "certain",
      "title": "Siss\u00fb",
      "start": -720,
      "provenance": "Pleiades",
      "uri": "https://pleiades.stoa.org/places/652350/sissu",
      "connectionType": "near",
      "id": "sissu",
      "attestations": [
        {
          "timePeriod": "neo-assyrian-babylonian-middle-east",
          "timePeriodURI": "https://pleiades.stoa.org/vocabularies/time-periods/neo-assyrian-babylonian-middle-east",
          "confidence": "confident",
          "confidenceURI": "https://pleiades.stoa.org/vocabularies/attestation-confidence/confident"
        }
