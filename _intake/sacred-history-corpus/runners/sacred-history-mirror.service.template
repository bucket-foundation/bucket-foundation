# Tier-B / copyrighted / NC / unclear remain gated INSIDE the runner.
# Network AI / Viatika x402 metered synthesis stays disabled ($0) in-runner.
ExecStart=/home/gian/agfarms/bucket-foundation/_intake/sacred-history-corpus/runners/sacred-history-runner.sh
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
