{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "gtm", "scripts/test-research-route.ts", "grants-gateway", "_intake", "yt", "archive", "pubmed", "arxiv", "blog", "gutenberg", "wikisource", "openalex", "openalex-fanout", "ads", "philpapers", "bucket-canon", "local", "feed402", "tools", "private", "data", "manifesto-source", "kruse-pitch", "checkpoints", "deploy", "feed", "research-landscape", "grants-targets", "canon-figures", "brand", "docs", "figma-export", "nonprofit-application", "build"]
}
