# research-tools LLM exposure — EXAMPLE env (safe to commit; contains NO secret).
# The real file lives at ~/.config/research-tools-llm/llm-shim.env (chmod 600,
# generated by setup.sh, NOT in git).

# Strong random bearer the shim requires on every request. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
LLM_GATEWAY_SECRET=replace-me-with-a-strong-random-token

# Shim bind (keep loopback — only cloudflared connects locally).
LLM_SHIM_HOST=127.0.0.1
LLM_SHIM_PORT=8011

# Upstream Ollama (OpenAI-compatible surface lives under /v1).
OLLAMA_URL=http://127.0.0.1:11434
LLM_SHIM_TIMEOUT_S=120

# Optional: a named cloudflared tunnel for a STABLE public hostname.
# CF_TUNNEL_NAME=research-llm
