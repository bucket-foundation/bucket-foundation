[Unit]
Description=Polingual Photon API (full 45k-photon dictionary, 5 axes)
After=network.target

[Service]
Type=simple
# %h = the running user's home. Data + venv live under ~/polingual-photon.
Environment=PHOTONS_DIR=%h/polingual-photon/photons
Environment=PORT=8088
Environment=POLINGUAL_RATE=120
Environment=POLINGUAL_CORS=https://bucket.foundation,https://www.bucket.foundation,https://bucket-foundation.vercel.app
WorkingDirectory=%h/polingual-photon
ExecStart=%h/polingual-photon/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=3
# Bounded memory cap so a leak can never starve other tenants on the box.
# Sized for the ~209k-photon index: ~425MB sqlite metadata loaded into Python
# lists at startup + the 612MB semantic memmap whose pages are touched by each
# semantic matmul (memmapped, not copied). Headroom to ~2GB resident; the box
# has 30GB so this is still a small, safe slice. Bump if photons grows again.
MemoryMax=2500M
MemoryHigh=2000M
# Light hardening (user service; no root).
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
