{
  "name": "bucket-foundation",
  "version": "0.2.0",
  "private": false,
  "engines": {
    "node": "24.x"
  },
  "description": "Open-source research data protocol over x402. Pay once per paper, cite it forever.",
  "license": "MIT",
  "homepage": "https://bucket.foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gianyrox/bucket-foundation.git"
  },
  "keywords": [
    "x402",
    "research",
    "open-science",
    "citations",
    "protocol",
    "open-source"
  ],
  "main": "index.js",
  "scripts": {
    "prepare": "bash scripts/install-git-hooks.sh || true",
    "predev": "node scripts/sync-academy.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-academy.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:comments": "node scripts/comments.mjs check",
    "test": "node scripts/run-tests.mjs --suite unit",
    "test:mcp": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-mcp-route.ts",
    "test:auth": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-auth-paths.ts",
    "test:dedup": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-research-os-dedup.ts && npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-research-os-merge-actions.ts",
    "waitlist:invite": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/waitlist-invite.ts",
    "test:waitlist": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-waitlist.ts",
    "test:academy": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-academy-engine.ts && npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-academy-diagnostic.ts && npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-academy-assess.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "db:local": "npx supabase@2.117.0 start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,pg_prove",
    "db:local:status": "npx supabase@2.117.0 status -o env",
    "db:local:reset": "npx supabase@2.117.0 db reset",
    "db:local:stop": "npx supabase@2.117.0 stop",
    "test:research-os": "node scripts/run-tests.mjs --suite research-os",
    "globe:landmask": "node scripts/globe/build-landmask.mjs",
    "seed:research-os": "node scripts/seed-research-os.mjs",
    "rebuild:research-os-ancestors": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/rebuild-prereq-ancestor.ts",
    "ingest:research-os:academy": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/research-os/ingest/academy-import.ts",
    "ingest:research-os:canon": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/research-os/ingest/canon-import.ts",
    "ingest:research-os:canon-claims": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/research-os/ingest/canon-claims.ts",
    "ingest:research-os:infer": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/research-os/ingest/infer-edges.ts",
    "ingest:research-os:infer-llm": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/research-os/ingest/infer-edges-llm.ts",
    "mint-kruse-token": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/mint-kruse-token.ts",
    "revoke-kruse-token": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/revoke-kruse-token.ts",
    "beads:export": "node scripts/beads-export.mjs",
    "test:polingual-roots": "python3 -m unittest scripts/photon/test_polingual_roots.py scripts/research-os/test_roots_v2.py scripts/research-os/test_oshb_verses.py scripts/research-os/test_arabic_root_gloss.py",
    "test:tools-ui": "node scripts/research-tools-ui.mjs",
    "test:nsm-exponents": "python3 -m unittest scripts/research-os/test_nsm_exponents.py scripts/research-os/test_clics_extract.py scripts/research-os/test_han_ids.py",
    "test:evidence-worker": "cd tools/evidence-search && python3 -m unittest discover -s tests -t .",
    "test:evidence-live": "EVIDENCE_REQUIRE_LIVE=1 npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-research-os-evidence-worker-live.ts",
    "ai-watch": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/research-os/ai-watch/cli.ts",
    "gate:evidence:runtime": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/research-os/evidence/bench.ts",
    "gate:evidence:model": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/research-os/evidence/model-gate.ts",
    "evolution:computing-import": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/research-os/evolution/computing-import.ts",
    "test:db": "node scripts/run-tests.mjs --suite db",
    "test:evidence-route-access": "TS_NODE_BASEURL=. npx ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"commonjs\",\"baseUrl\":\".\"}' scripts/test-research-os-evidence-route-access.ts",
    "gate:evidence:saturate": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/research-os/evidence/saturate.ts"
  },
  "author": "bucket.foundation contributors",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@auth/core": "^0.37.0",
    "@pinata/sdk": "^2.1.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.6",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^1.3.1",
    "jose": "^6.2.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "lz-string": "^1.5.0",
    "next": "14.2.15",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.170.0",
    "ts-node": "^10.9.2",
    "viem": "^2.21.29"
  },
  "devDependencies": {
    "@playwright/test": "1.58",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.170.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8",
    "prettier": "3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
