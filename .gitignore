# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.beads/

# gtm video build artifacts (binaries, mirror to gdrive instead)
gtm/video-v*/

# local GPU LLM endpoint (auth-shim secret, runtime logs, tunnel URL) — never commit
scripts/llm/.bearer-secret
scripts/llm/logs/
scripts/llm/.tunnel-url

# Site mirrors (large binaries — mirror to gdrive instead)
bucket-canon/**/site-mirror/
__pycache__/

# Dolt database files (added by bd init)
.dolt/
*.db

# Concept art / source images live on gdrive, not git
# (see manifesto-source/<topic>/<date>/INDEX.md for share links)
manifesto-source/**/*.png
manifesto-source/**/*.jpg
manifesto-source/**/*.jpeg
manifesto-source/**/*.heic
manifesto-source/**/*.webp

# subproject node_modules — never commit
grants-gateway/node_modules/
/private/
grants-targets/.longtail-submissions.jsonl
.fts.sqlite
brand/workshop/
bucket.foundation.pdf
checkpoints/
figma-export/
feed/2026-*
*.png

# …EXCEPT the vendored paper/research figures under public/, which are part of
# the shipped site (the research-atlas paper pages + the education-atlas corpus
# render them) and MUST reach Vercel. Without these negations the blanket
# `*.png` above silently strips every figure from git — which is exactly why the
# paper-01 figures were missing in production. Keep these tracked.
!public/papers/**/*.png
!public/education/**/*.png
# …and the UX research captures (evidence for the UX gap analysis).
!learning/research/ux/captures/**/*.png

# Trained ML artifacts.
# Large weights go to HuggingFace Hub for collaborators (see REPRODUCE.md):
_intake/training/canon-bge-small-v1/model.safetensors
_intake/training/canon-bge-small-v1/tokenizer.json
# Smaller artifacts ARE committed so collaborators see the full knowledge
# graph out of the box:
#   _intake/training/kg.gpickle              (~325KB) networkx graph
#   _intake/training/kg-embeddings.npy       (~580KB) node2vec embeddings
#   _intake/training/kg-nodes.jsonl          (~267KB) node metadata
#   _intake/training/tier-classifier.pt      (~267KB) tier MLP weights
#   _intake/training/tier-predictions.jsonl  per-claim tier predictions
#   _intake/embeddings-v2/claims-vectors.npy (~920KB) canon-tuned 384-d vecs
#   _intake/embeddings/claim-evidence.jsonl  (~5.5MB) top-K evidence per claim

.venv-shorts/
shorts-runs/

# Photon index — sqlite + vector matrices are large; regenerate from
# tools (see PHOTON-SPEC.md). The spec + tools + sample photons may be
# committed, but the full vector matrices are not.
_intake/photons/index.sqlite
_intake/photons/*.f32.bin
# Bulk-ingest artifacts: the consolidated CSV + per-language kaikki
# JSONL cache (10s of GB). Regenerate via photon-kaikki-bulk2.py.
_intake/photons/bulk.csv
_intake/photons/bulk.log
_intake/photons/kaikki-cache/
_intake/photons/all.json.gz
_intake/photons/smoke.csv

# canon-intake convergent runner runtime state (logs, lock, status snapshot).
# The runner WRITES bucket-canon/**/primary-papers.yaml (committed by the data
# pillar); this dir is just its bookkeeping and must never dirty the tree.
_intake/canon-intake/

# bkt-su9: generated Academy Supabase config in the served mirror. Built from
# public env by scripts/sync-academy.mjs on each build (incl. Vercel). The anon
# key is public by design, but we keep the generated copy out of git so a real
# key is never committed via the mirror. The empty source default at
# learning/app/js/auth-config.js IS committed (so ./serve.sh works standalone).
public/academy-app/js/auth-config.js
scripts/llm/shim.env

# UX capture videos live in gdrive (AGFarms/Nucleus/bucket-foundation/academy-ux), not the repo
learning/research/ux/captures/**/*.webm
learning/research/ux/captures/**/*.mp4
_intake/health-longevity-fitness/reports/viz/_struct/
_intake/health-longevity-fitness/reports/viz/_audit_thumbs/
_intake/health-longevity-fitness/reports/viz/_contact-sheets/
